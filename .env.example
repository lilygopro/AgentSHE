BASE_URL=http://127.0.0.1:8787
# Pour un lien Connecter PERMANENT (ne change jamais) :
# 1) Domaine ou VPS public, ex:
#    BASE_URL=https://agentshe.mondomaine.com
# 2) Optionnel — tunnel Cloudflare nommé (Zero Trust → token) si le bot est en local :
#    TUNNEL_TOKEN=eyJhIjoi...
#    (dans le dashboard CF : Public Hostname = agentshe.mondomaine.com → http://127.0.0.1:8787)
TUNNEL_TOKEN=
ADMIN_KEY=change-me
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot
TELEGRAM_ALLOWED_IDS=
HOST=0.0.0.0
PORT=8787
# Repo privé (backup / releases via gh). Les PC téléchargent via le tunnel bot /files/
GITHUB_REPO=lilygopro/AgentSHE
GITHUB_RELEASE_TAG=v1.0.8
